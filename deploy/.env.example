# =====================================================================
# 天玑 · 售后看板  生产环境变量
# 用法：复制为  .env  并填入真实值；权限务必 600；切勿提交到 git / 云端仓库
#   cp .env.example .env && chmod 600 .env
# =====================================================================

# ---- 服务监听（Caddy 反代到它，所以只绑本地回环）----
BI_HOST=127.0.0.1
BI_PORT=8899

# ---- 安全 ----
# 只允许你自己的站点跨域调用；留空=同源部署，不发跨域头（更安全）
BI_ALLOWED_ORIGIN=
# HTTPS 部署下必须开（Cookie 加 Secure）；本地 http 调试时设 0
BI_COOKIE_SECURE=1
# 登录失败锁定：15 分钟内失败 8 次即锁
BI_LOGIN_MAX_FAIL=8
BI_LOGIN_WINDOW=900
# 会话库（默认放项目目录，可改到持久盘）
# BI_SESSION_DB=/opt/tianji-bi/sessions.db

# ---- AI 供应商密钥（关键：只存在服务端，前端永远拿不到）----
AI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_API_KEY=sk-在这里填你的密钥

# ---- 飞书（推荐：OpenAPI 直连，跨平台、无需 lark-cli）----
# 前置（飞书开放平台 → 你的自建应用）：
#   1) 开通权限：drive:drive
#   2) 把目标文件夹「客户优化方案」共享给该应用（添加应用为协作者，可编辑）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=在此填应用密钥
# 分享链接域名（你的飞书租户域名，与文件夹链接一致）
FEISHU_SHARE_HOST=iihcw7mp26x.feishu.cn
# 云空间目标文件夹 token
DRIVE_FOLDER=MgWffMXFzlJWn4dDtVIcEdSpn2b

# ---- 回退方案：仅当上面应用凭证未配置时，才会用到 lark-cli ----
LARK_CLI=/usr/local/bin/lark-cli
# 客户成功经理 -> 飞书 open_id 映射表（含个人信息，注意权限）
CSM_MAP_FILE=/etc/tianji-bi/csm_feishu_map.json
